{
  "name": "allen-aligner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test scripts/portal-unit.test.cjs scripts/case-lifecycle.test.cjs scripts/extended-workflow.test.cjs scripts/password-format.test.cjs scripts/plan-version-control.test.cjs scripts/case-detail-render.test.cjs scripts/quality-management.test.cjs scripts/inventory-management.test.cjs scripts/manufacturing-orders.test.cjs",
    "test:portal": "node scripts/portal-integration.cjs",
    "portal:admin": "node scripts/portal-admin.cjs",
    "typecheck": "tsc --noEmit",
    "test:large-uploads": "node scripts/large-upload-integration.cjs",
    "db:check": "node scripts/db-check.cjs",
    "db:manufacturing-orders": "node scripts/apply-manufacturing-orders.cjs",
    "db:doctor-registration": "node scripts/setup-doctor-registration.cjs",
    "db:work-reporting": "node scripts/work-reporting-migrate.cjs",
    "test:invitations": "node scripts/verify-employee-invitations.cjs",
    "db:invitations": "node scripts/verify-employee-invitations.cjs --apply",
    "test:plan-versions": "node --experimental-strip-types --test scripts/plan-version-control.test.cjs",
    "test:plan-versions:db": "node scripts/verify-plan-version-control.cjs",
    "db:plan-versions": "node scripts/verify-plan-version-control.cjs --apply",
    "db:reviewer-identity": "node scripts/apply-reviewer-identity-migration.cjs",
    "db:clinical-planning-queue": "node scripts/clinical-planning-queue-migrate.cjs",
    "db:payroll": "node scripts/install-payroll-management.cjs",
    "dev:local": "next dev --hostname 127.0.0.1",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
