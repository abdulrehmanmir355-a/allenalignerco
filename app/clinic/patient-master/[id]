
"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import { useEffect, useState } from "react";

type Patient = {
  id: string;
  patientReference?: string | null;
  fullName?: string | null;
  name?: string | null;
  status?: string | null;
  createdAt?: string | null;
  updatedAt?: string | null;
};

export default function PatientProfilePage() {
  const params = useParams();
  const patientId = params.id;

  const [patient, setPatient] = useState<Patient | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    if (typeof patientId !== "string") {
      setError("Invalid patient ID.");
      setLoading(false);
      return;
    }

    const controller = new AbortController();

    async function loadPatient() {
      try {
        const response = await fetch(
          "/api/clinic/manage/patients",
          {
            credentials: "same-origin",
            cache: "no-store",
            signal: controller.signal,
          }
        );

        if (!response.ok) {
          throw new Error("Patient access denied or unavailable.");
        }

        const data = await response.json();

        if (!Array.isArray(data.records)) {
          throw new Error("Invalid patient response.");
        }

        const found = (data.records as Patient[]).find(
          (item) => item.id === patientId
        );

        if (!found) {
          throw new Error("Patient not found in accessible records.");
        }

        setPatient(found);
      } catch (err) {
        if (!controller.signal.aborted) {
          setError(
            err instanceof Error
              ? err.message
              : "Unable to load patient."
          );
        }
      } finally {
        if (!controller.signal.aborted) {
          setLoading(false);
        }
      }
    }

    loadPatient();

    return () => controller.abort();
  }, [patientId]);

  const displayDate = (value?: string | null) => {
    if (!value) return "Not available";

    const date = new Date(value);
    return Number.isNaN(date.getTime())
      ? "Not available"
      : date.toLocaleString();
  };

  return (
    <main
      className="container section"
      style={{ maxWidth: 900, margin: "0 auto", padding: 24 }}
    >
      <Link href="/clinic/patient-master">
        ← Back to Patient Master
      </Link>

      <h1 style={{ marginTop: 24 }}>Patient Profile</h1>

      {loading && <p>Loading patient...</p>}

      {error && (
        <p role="alert" style={{ color: "crimson" }}>
          {error}
        </p>
      )}

      {patient && !loading && !error && (
        <section
          style={{
            border: "1px solid #ddd",
            borderRadius: 12,
            padding: 24,
            marginTop: 24,
          }}
        >
          <h2>
            {patient.fullName ||
              patient.name ||
              patient.patientReference ||
              "Patient"}
          </h2>

          <dl style={{ lineHeight: 2.2 }}>
            <dt><strong>Internal Patient ID</strong></dt>
            <dd>{patient.id}</dd>

            <dt><strong>Patient Reference</strong></dt>
            <dd>{patient.patientReference || "Not available"}</dd>

            <dt><strong>Status</strong></dt>
            <dd>{patient.status || "Not available"}</dd>

            <dt><strong>Created</strong></dt>
            <dd>{displayDate(patient.createdAt)}</dd>

            <dt><strong>Last Updated</strong></dt>
            <dd>{displayDate(patient.updatedAt)}</dd>
          </dl>
        </section>
      )}
    </main>
  );
}
